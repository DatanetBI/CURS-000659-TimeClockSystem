@using Microsoft.AspNetCore.Identity
@using TimeClockSystem.Web.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-white-50">@UserManager.GetUserName(User)</span>
        </li>
        <li class="nav-item">
            <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post" class="d-flex">
                <button type="submit" class="btn btn-link nav-link">Cerrar sesión</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a>
        </li>
    }
</ul>
