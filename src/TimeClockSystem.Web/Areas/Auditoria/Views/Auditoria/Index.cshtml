@model TimeClockSystem.Web.Areas.Auditoria.Models.AuditoriaViewModel
@{
    ViewData["Title"] = "Auditoría";
}

<h1 class="h3 mb-3">Auditoría</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label class="form-label">Desde</label>
        <input type="date" name="desde" value="@Model.Filtro.Desde?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">Hasta</label>
        <input type="date" name="hasta" value="@Model.Filtro.Hasta?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">Usuario</label>
        <input type="text" name="usuario" value="@Model.Filtro.Usuario" class="form-control" placeholder="Id de usuario/empleado" />
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Fecha (UTC)</th>
                <th>Evento</th>
                <th>Usuario/Empleado</th>
                <th>Detalle</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var fila in Model.Elementos)
        {
            <tr>
                <td>@fila.TimestampUtc.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@fila.Evento</td>
                <td>@fila.UsuarioOEmpleadoId</td>
                <td>@fila.Detalle</td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Elementos.Any())
    {
        <p class="text-muted">No hay eventos de auditoría para los filtros seleccionados.</p>
    }
</div>

@if (Model.TotalPaginas > 1)
{
    <nav>
        <ul class="pagination">
            @for (var i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.Filtro.Pagina ? "active" : "")">
                    <a class="page-link" asp-route-desde="@Model.Filtro.Desde" asp-route-hasta="@Model.Filtro.Hasta" asp-route-usuario="@Model.Filtro.Usuario" asp-route-pagina="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
