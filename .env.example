# Plantilla de variables de entorno para docker-compose.yml (Principio V de la constitución:
# ningún secreto en texto plano en imágenes ni archivos versionados).
#
# Copiar este archivo a ".env" (que está en .gitignore y NUNCA debe versionarse) y reemplazar los
# valores de ejemplo por valores propios antes de ejecutar "docker compose up --build".

# Contraseña de la cuenta "sa" de SQL Server. MUST cumplir la política de complejidad de SQL
# Server: mínimo 8 caracteres, y al menos 3 de las 4 categorías (mayúsculas, minúsculas, dígitos,
# símbolos).
MSSQL_SA_PASSWORD=ChangeMe_2026!

# Clave simétrica usada para firmar y validar los tokens JWT emitidos por el Backend. Usar un
# valor largo y aleatorio propio; nunca reutilizar este valor de ejemplo.
JWT_SIGNING_KEY=replace-with-a-long-random-value
